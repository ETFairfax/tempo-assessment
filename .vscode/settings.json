{
  "[css]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[javascript]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[typescript]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "editor.codeActionsOnSave": {
    "source.fixAll.biome": "explicit",
    "source.organizeImports.biome": "explicit"
  },
  "editor.defaultFormatter": "biomejs.biome",
  "editor.formatOnSave": true,
  "editor.quickSuggestions": {
    "strings": "on"
  },
  "explorer.compactFolders": false,
  "files.associations": {
    "*.css": "tailwindcss"
  },
  "files.exclude": {
    "**/.turbo": true,
    "**/*.tsbuildinfo": false,
    "**/coverage": true,
    "**/dist": true,
    "**/node_modules": true
  },
  "files.watcherExclude": {
    "**/.turbo": true,
    "**/*.tsbuildinfo": true,
    "**/coverage": true,
    "**/dist": false,
    "**/node_modules": true
  },
  "githubPullRequests.defaultMergeMethod": "squash",
  "githubPullRequests.fileListLayout": "tree",
  "githubPullRequests.notifications": "pullRequests",
  "githubPullRequests.pullBranch": "prompt",
  "githubPullRequests.showPullRequestNumberInTree": true,
  "js/ts.tsdk.path": "./node_modules/typescript/lib",
  "js/ts.tsdk.promptToUseWorkspaceVersion": true,
  "js/ts.tsserver.automaticTypeAcquisition.enabled": true,
  "search.exclude": {
    "**/.turbo": true,
    "**/*.tsbuildinfo": true,
    "**/coverage": true,
    "**/dist": false,
    "**/node_modules": true
  },
  "tailwindCSS.classAttributes": [
    "class",
    "className",
    "ngClass",
    ".*[cC]lass.*"
  ],
  "tailwindCSS.experimental.classRegex": [
    // For cva function calls
    [
      "cva\\(([^)]*)\\)",
      "(?:'|\"|`)([^'\"`]*)(?:'|\"|`)"
    ],
    // For cn function calls
    [
      "cn\\(([^)]*)\\)",
      "(?:'|\"|`)([^'\"`]*)(?:'|\"|`)"
    ]
  ],
  "tailwindCSS.experimental.configFile": "packages/ui/src/styles/globals.css",
  "terminal.integrated.fontFamily": "MesloLGM Nerd Font",
  "terminal.integrated.shellIntegration.decorationsEnabled": "never",
  "workbench.colorCustomizations": {
    "titleBar.activeBackground": "#0b4b84",
    "titleBar.activeForeground": "#fff"
  },
  "workbench.colorTheme": "Dark Modern"
}
